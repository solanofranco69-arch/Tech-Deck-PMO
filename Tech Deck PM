@app.route("/reset-password/<token>", methods=["GET", "POST"])
def reset_password(token):
    current_user = get_current_user()
    reset_entry = ResetToken.query.filter_by(token=token).first()

    if not reset_entry or reset_entry.used or reset_entry.expires_at < datetime.utcnow():
        flash("This reset link is invalid, expired, or has already been used.")
        return redirect(url_for("login"))

    if request.method == "POST":
        password = request.form.get("password", "")
        confirm = request.form.get("confirm_password", "")

        if password != confirm:
            flash("Passwords do not match.")
            return render_page("<p>Passwords do not match.</p>", current_user)

        user = User.query.get(reset_entry.user_id)
        if not user:
            flash("The user associated with this reset link no longer exists.")
            return redirect(url_for("login"))

        user.password_hash = generate_password_hash(password)
        reset_entry.used = True
        db.session.commit()
        flash("Your password has been updated. You can sign in now.")
        return redirect(url_for("login"))

    body = """
    <div class="row justify-content-center">
      <div class="col-lg-5">
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h1 class="h3 mb-3">Choose a new password</h1>
            <form method="post">
              <div class="mb-3">
                <label class="form-label">New password</label>
                <input type="password" name="password" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Confirm password</label>
                <input type="password" name="confirm_password" class="form-control" required>
              </div>
              <div class="d-grid">
                <button class="btn btn-primary" type="submit">Update password</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    """
    return render_page(body, current_user)


if __name__ == "__main__":
    app.run(debug=True)
