          </div>
          {edit_block}
        </div>"""

    if not rows:
        rows = '<div class="empty">No charges yet.</div>'

    worker_opts = "".join(f'<option value="{w.id}">{w.email}</option>' for w in workers)

    return f"""
    <div class="section-label">Charges</div>
