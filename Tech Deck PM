          <div class="exp-row-top">
            <div>
              <div class="exp-label">{exp.description or exp.category}</div>
              <div class="exp-meta">{exp.date.strftime('%b %d, %Y')} &nbsp;·&nbsp; {exp.category} &nbsp;·&nbsp; {exp.worker.email}</div>
