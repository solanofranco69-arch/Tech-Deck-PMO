@app.route("/project/<int:project_id>/inventory/<int:item_id>", methods=["POST"])
@login_required
def update_inventory_item(project_id, item_id):
    project = Project.query.get_or_404(project_id)
    item = InventoryItem.query.get_or_404(item_id)

    if item.project_id != project.id:
        flash("Inventory item could not be found for this project.")
        return redirect(url_for("project_dashboard", project_id=project.id))

    action = request.form.get("action", "set")
    adjustment = abs(float(request.form.get("adjustment_amount", 0) or 0))

    if action == "add":
        item.total_used += adjustment
        message = "Inventory increased."
    elif action == "remove":
        item.total_used = max(0.0, item.total_used - adjustment)
        message = "Inventory reduced."
    else:
        item.total_used = adjustment
        message = "Inventory updated."

    item.last_updated = datetime.utcnow()
    db.session.commit()
    flash(message)
    return redirect(url_for("project_dashboard", project_id=project.id))


@app.route("/project/<int:project_id>/expenditure", methods=["POST"])
@login_required
def add_expenditure(project_id):
    project = Project.query.get_or_404(project_id)

    receipt_filename = None
    receipt_image_url = None
    ocr_data = {}

    if "receipt" in request.files:
        receipt_file = request.files["receipt"]
        if receipt_file and receipt_file.filename:
            receipt_filename = save_uploaded_image(receipt_file)
            receipt_image_url = url_for("uploaded_file", filename=receipt_filename)
            ocr_path = os.path.join(app.config["UPLOAD_FOLDER"], receipt_filename)
            ocr_data = perform_ocr_on_image(ocr_path)

    description = request.form.get("description", "").strip()
    amount = request.form.get("amount", "")
    date_value = request.form.get("date") or datetime.utcnow().date().isoformat()

    if not description and ocr_data.get("vendor"):
        description = ocr_data.get("vendor")
    if not amount and ocr_data.get("amount") is not None:
        amount = ocr_data.get("amount")

    try:
        parsed_date = datetime.strptime(date_value, "%Y-%m-%d").date()
    except ValueError:
        parsed_date = datetime.utcnow().date()

    expense = Expenditure(
        project_id=project.id,
        worker_id=int(request.form.get("worker_id", 0)),
        date=parsed_date,
        category=request.form.get("category", "Others"),
        amount=float(amount or 0),
        description=description or "Receipt upload",
        receipt_image_url=receipt_image_url,
    )
    db.session.add(expense)
    db.session.commit()

    if ocr_data:
        flash("Receipt OCR parsed. Review and confirm the amount and description.")
    else:
        flash("Expenditure saved.")

    return redirect(url_for("project_dashboard", project_id=project.id))


