@app.route("/worker/<int:project_id>/inventory/add", methods=["POST"])
@login_required
def worker_add_inventory(project_id):
    project = Project.query.get_or_404(project_id)
    item = InventoryItem(
        project_id=project.id,
        category=request.form.get("category", "Others"),
        description=request.form.get("description", "").strip(),
        unit=request.form.get("unit", "m"),
        total_used=float(request.form.get("total_used", 0) or 0),
        location=request.form.get("location", "").strip(),
    )
    db.session.add(item)
    db.session.commit()
    flash("Item added.")
    return redirect(url_for("worker_project", project_id=project_id) + "?tab=inventory")


@app.route("/worker/<int:project_id>/inventory/<int:item_id>/update", methods=["POST"])
@login_required
def worker_update_inventory(project_id, item_id):
    item = InventoryItem.query.get_or_404(item_id)
    if item.project_id != project_id:
        flash("Item not found.")
        return redirect(url_for("worker_project", project_id=project_id) + "?tab=inventory")
    item.category = request.form.get("category", item.category)
    item.description = request.form.get("description", item.description).strip()
    item.unit = request.form.get("unit", item.unit)
    item.total_used = float(request.form.get("total_used", item.total_used) or item.total_used)
    item.location = request.form.get("location", item.location or "").strip()
    item.last_updated = datetime.utcnow()
    db.session.commit()
    flash("Item updated.")
    return redirect(url_for("worker_project", project_id=project_id) + "?tab=inventory")


@app.route("/worker/<int:project_id>/inventory/<int:item_id>/delete", methods=["POST"])
