    flash("Item removed.")
    return redirect(url_for("worker_project", project_id=project_id) + "?tab=inventory")


@app.route("/worker/<int:project_id>/expenditure/<int:exp_id>/edit", methods=["POST"])
@login_required
def worker_edit_expenditure(project_id, exp_id):
    exp = Expenditure.query.get_or_404(exp_id)
    if exp.project_id != project_id:
        flash("Charge not found.")
        return redirect(url_for("worker_project", project_id=project_id) + "?tab=charges")
    date_str = request.form.get("date") or datetime.utcnow().date().isoformat()
    try:
        exp.date = datetime.strptime(date_str, "%Y-%m-%d").date()
    except ValueError:
        exp.date = datetime.utcnow().date()
    exp.amount = float(request.form.get("amount", exp.amount) or exp.amount)
    exp.category = request.form.get("category", exp.category)
    exp.worker_id = int(request.form.get("worker_id", exp.worker_id))
    exp.description = request.form.get("description", exp.description or "").strip()
    db.session.commit()
    flash("Charge updated.")
    return redirect(url_for("worker_project", project_id=project_id) + "?tab=charges")


