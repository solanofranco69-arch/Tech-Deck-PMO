@app.route("/worker/<int:project_id>")
@login_required
def worker_project(project_id):
    project = Project.query.get_or_404(project_id)
    tab = request.args.get("tab", "inventory")
    edit_inv = request.args.get("edit_inv", type=int)
    edit_exp = request.args.get("edit_exp", type=int)

    if tab == "inventory":
        body = _worker_inventory_tab(project, edit_inv)
    else:
        body = _worker_charges_tab(project, edit_exp)

    return render_worker(
        body,
        header_sub=project.name,
        tab_bar=True,
        active_tab=tab,
        project_id=project_id,
    )


