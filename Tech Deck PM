def ensure_project_schema():
    inspector = inspect(db.engine)
    columns = {column["name"] for column in inspector.get_columns("project")}
    migrations = [
        ("client_name", "VARCHAR(120)"),
        ("client_email", "VARCHAR(120)"),
        ("client_phone", "VARCHAR(40)"),
        ("client_company", "VARCHAR(120)"),
        ("client_address", "VARCHAR(200)"),
        ("payment_structure", "VARCHAR(200)"),
        ("payment_dates", "VARCHAR(200)"),
        ("payment_amounts", "VARCHAR(200)"),
        ("discount_amount", "FLOAT"),
        ("discount_reason", "VARCHAR(200)"),
        ("payment_methods", "VARCHAR(200)"),
        ("receiving_accounts", "VARCHAR(200)"),
        ("installment_schedule", "VARCHAR(200)"),
    ]

    for column_name, column_type in migrations:
        if column_name not in columns:
            db.session.execute(text(f"ALTER TABLE project ADD COLUMN {column_name} {column_type}"))

    db.session.commit()


def login_required(view_func):
    @wraps(view_func)
    def wrapper(*args, **kwargs):
        if "user_id" not in session:
            flash("Please sign in to continue.")
            return redirect(url_for("login"))
        return view_func(*args, **kwargs)

    return wrapper


def get_current_user():
    user_id = session.get("user_id")
    if not user_id:
        return None
    return User.query.get(user_id)


def save_uploaded_image(file_storage):
    if not file_storage:
        return None

    filename = f"{uuid.uuid4().hex}_{file_storage.filename}"
    filepath = os.path.join(app.config["UPLOAD_FOLDER"], filename)
    file_storage.save(filepath)
    return filename


def extract_ocr(text):
    vendor = None
    invoice_date = None
    amount = None

    match = re.search(r"Vendor[:\s]+([^\n]+)", text, re.IGNORECASE)
    if match:
        vendor = match.group(1).strip()

    match = re.search(r"Date[:\s]+([0-9]{2,4}[/.-][0-9]{1,2}[/.-][0-9]{2,4})", text, re.IGNORECASE)
    if match:
        invoice_date = match.group(1).strip()

    match = re.search(r"Amount[:\s]+\$?([0-9]+(?:\.[0-9]{2})?)", text, re.IGNORECASE)
    if match:
        amount = float(match.group(1))

    return {"vendor": vendor, "invoice_date": invoice_date, "amount": amount}


def perform_ocr_on_image(filepath):
    if not OCR_AVAILABLE:
        return {}

    try:
        text = pytesseract.image_to_string(Image.open(filepath))
        return extract_ocr(text)
