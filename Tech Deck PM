def _worker_charges_tab(project, edit_exp_id=None):
    expenditures = (
        Expenditure.query.filter_by(project_id=project.id)
        .join(User)
        .order_by(Expenditure.date.desc(), Expenditure.created_at.desc())
        .all()
    )
    workers = User.query.order_by(User.email.asc()).all()
    today = datetime.utcnow().date().isoformat()

    rows = ""
    for exp in expenditures:
        badge = f'<span class="badge-ok">Reconciled</span>' if exp.is_reconciled else f'<span class="badge-pending">Pending</span>'
        edit_block = ""
        if edit_exp_id == exp.id:
            worker_opts = "".join(
                f'<option value="{w.id}" {"selected" if w.id == exp.worker_id else ""}>{w.email}</option>'
                for w in workers
